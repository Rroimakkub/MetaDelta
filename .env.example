# Discord Developer Portal > Bot
DISCORD_BOT_TOKEN=
# Discord Developer Portal > General Information
DISCORD_CLIENT_ID=

# DeltaForceAPI production service. Do not commit a real API key.
# Create one with: npm run create-key
DELTAFORCE_API_TOKEN=
DELTAFORCE_API_BASE_URL=https://api.deltaforceapi.com

# Optional: extra items whose market price is posted after the craft recommendations.
# Comma-separated UUID|display name. Example: MARKET_ITEMS=123e4567-e89b-12d3-a456-426614174000|Example item
MARKET_ITEMS=

# Set true to test Discord posting with sample data, without calling the API.
DEMO_MODE=true

# Market tax taken from the sale price, in percent.
SELL_TAX_PERCENT=13

# Crafts shown per workshop (1-10). 1 posts one 2x2 grid image covering all workshops.
TOP_PER_WORKSHOP=1

# How often tracked players are checked for new matches, in minutes (5-120).
TRACK_INTERVAL_MINUTES=10

# Time zone and posting time, in 24-hour HH:MM format.
TIME_ZONE=Asia/Bangkok
POST_TIME=09:00
